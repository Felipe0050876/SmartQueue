@{
    string seccion = ViewBag.Seccion as string;
    bool autenticado = User.Identity != null && User.Identity.IsAuthenticated;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · SmartQueue</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (autenticado)
    {
        <header class="topbar">
            <div class="topbar-inner">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="marca">SQ</span>
                    <span>SmartQueue</span>
                </a>
                <nav class="nav-menu">
                    <a asp-controller="Home" asp-action="Index" class="@(seccion == "panel" ? "activo" : "")">Panel</a>
                    <a asp-controller="Solicitudes" asp-action="Index" class="@(seccion == "solicitudes" ? "activo" : "")">Solicitudes</a>
                    <a asp-controller="Turnos" asp-action="Index" class="@(seccion == "turnos" ? "activo" : "")">Turnos</a>
                    <a asp-controller="Historial" asp-action="Index" class="@(seccion == "historial" ? "activo" : "")">Historial</a>
                </nav>
                <div class="topbar-user">
                    <span>@User.Identity.Name</span>
                    <a class="salir" asp-controller="Cuenta" asp-action="Logout">Salir</a>
                </div>
            </div>
        </header>
        <main class="contenido">
            @RenderBody()
        </main>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
